rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cualquier usuario autenticado con cuenta registrada (email/contraseña o
    // Google, es decir NO anónimo) puede crear y ser master de su propia
    // partida. Los jugadores entran con sesión anónima, así que quedan
    // excluidos de poder crear partidas.
    function esUsuarioRegistrado() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function esElMasterDeEstaPartida(partidaId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/partidas/$(partidaId)).data.masterUid == request.auth.uid;
    }

    // Los jugadores pueden actualizar SOLO estos dos campos del documento de
    // la partida (nunca la historia, config, ni nada más): "enemigos" para
    // aplicar daño en combate, y "escenaActual" para el avance automático
    // del guion. Cualquier otro campo en la misma escritura la rechaza.
    function esActualizacionDeJugadorPermitida() {
      return request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enemigos', 'escenaActual', 'combate', 'votacion']);
    }

    match /partidas/{partidaId} {
      allow read: if request.auth != null; // los jugadores necesitan leer para unirse por código
      allow create: if esUsuarioRegistrado();
      allow update: if esElMasterDeEstaPartida(partidaId) || esActualizacionDeJugadorPermitida();
      allow delete: if esElMasterDeEstaPartida(partidaId);

      match /jugadores/{jugadorId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null; // cualquiera autenticado (anónimo) puede unirse
        allow update: if request.auth != null &&
          (resource.data.uid == request.auth.uid ||
           esElMasterDeEstaPartida(partidaId) ||
           // Los ataques automáticos de los enemigos en combate los puede
           // resolver cualquier jugador conectado (no siempre el master
           // está mirando la pantalla) — pero solo puede tocar la vida,
           // nunca el resto de la ficha de otro jugador.
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vida']));
        allow delete: if esElMasterDeEstaPartida(partidaId);
      }

      match /marcadores/{marcadorId} {
        allow read: if request.auth != null;
        allow write: if esElMasterDeEstaPartida(partidaId);
      }

      match /plantillasPersonaje/{plantillaId} {
        allow read: if request.auth != null;
        allow write: if esElMasterDeEstaPartida(partidaId);
      }

      match /eventos/{eventoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null; // dados de jugadores + narración de master
        allow update, delete: if esElMasterDeEstaPartida(partidaId);
      }
    }

    // Un doc por master, con cuántas "partidas extra" ha desbloqueado viendo
    // anuncios (por encima de las 2 gratis). Solo el propio master puede
    // leerlo/escribirlo — nunca otro usuario.
    match /masters/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Progreso persistente del jugador (nivel, experiencia, logros), ligado
    // a su propia sesión — anónima o registrada. Sobrevive entre partidas
    // mientras no borre los datos del navegador ni cambie de dispositivo.
    match /progreso/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking de partidas completadas, visible para cualquiera autenticado
    // (para poder comparar entre grupos), pero solo el master de esa
    // partida puede añadir una entrada.
    match /rankings/{entradaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // NUEVO JUEGO: Reinos (estrategia medieval, sin master, hasta 10
    // jugadores por mundo, tiempo real, persistente). Independiente de
    // todo lo de arriba (Rúnica se queda intacto).
    // ---------------------------------------------------------------
    match /mundos/{mundoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Contador de jugadores/estado general del mundo — cualquiera
      // conectado puede necesitar actualizarlo (p.ej. al unirse).
      allow update: if request.auth != null;

      match /reinos/{reinoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == reinoId;
        allow update: if request.auth != null &&
          (request.auth.uid == reinoId ||
           // Resolver una batalla (ataque o defensa) puede tocar el
           // ejército/territorios de OTRO reino — nunca sus recursos,
           // edificios ni nada más. Lo puede hacer cualquier jugador
           // conectado, no hace falta que sea el propio dueño.
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ejercito', 'territorios', 'vivo']));
        allow delete: if request.auth != null && request.auth.uid == reinoId;
      }

      match /movimientos/{movId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Resolver un movimiento (marcarlo como llegado/resuelto) lo
        // puede hacer cualquier jugador conectado — igual que los turnos
        // automáticos de enemigos en Rúnica, no depende de que un solo
        // cliente concreto esté mirando en ese momento.
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }

      // Chat del mundo: cualquier jugador conectado puede leer y escribir,
      // pero solo en su propio nombre (no se puede suplantar a otro).
      match /mensajes/{mensajeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.autorUid == request.auth.uid;
      }

      // Pactos de alianza entre dos reinos: cualquiera puede proponer (en
      // su propio nombre), y cualquiera de las dos partes puede aceptar,
      // rechazar o romper el pacto después.
      match /pactos/{pactoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.propuestoPor == request.auth.uid;
        allow update: if request.auth != null;
      }

      // Ladrones/espías: igual que los movimientos de ejército, se
      // resuelven solos con el paso del tiempo, por cualquier cliente
      // conectado.
      match /ladrones/{ladronId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }

      // Ataques conjuntos entre aliados: el que propone lo crea en su
      // propio nombre; el aliado invitado (o cualquiera de los dos, para
      // lanzar/cancelar) puede actualizarlo después.
      match /ataquesConjuntos/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.iniciadorUid == request.auth.uid;
        allow update: if request.auth != null;
      }
    }
  }
}
